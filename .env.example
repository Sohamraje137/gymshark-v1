# Copy this file to .env.local and fill in the values. See SETUP.md for how to get each one.

# Random secret used to sign/encrypt the JWT session cookie.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public URL of the app. Leave as-is for local dev; set to https://your-domain in production.
AUTH_URL=http://localhost:3000
# Needed when running behind a reverse proxy (nginx, Caddy, Docker, most clouds).
AUTH_TRUST_HOST=true

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/sachina
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sachina?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sachina

# Comma-separated list of Google emails that are always admins.
ADMIN_EMAILS=you@example.com
