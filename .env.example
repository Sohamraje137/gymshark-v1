# Copy this file to .env.local and fill in the values. See SETUP.md for how to get each one.

# Random secret used to sign/encrypt the JWT session cookie.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public URL of the app. Leave unset in local dev so sign-in stays on whatever host you opened
# (localhost, 127.0.0.1, or your LAN IP); set to https://your-domain in production.
# AUTH_URL=https://your-domain
# Use the request's host for redirects. Also needed behind a reverse proxy (nginx, Caddy, Docker, most clouds).
AUTH_TRUST_HOST=true

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/sachina
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sachina?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sachina

# Comma-separated list of emails that are always coaches. Everyone else signs up as a client.
COACH_EMAILS=you@example.com

# Escape-hatch login without Google, for development before Google approves the app.
# Off unless "true". In production it also requires DEV_LOGIN_PASSCODE. Never enable on a public server without one.
DEV_LOGIN_ENABLED=false
DEV_LOGIN_PASSCODE=
